# 环境变量示例：只放变量名与示例值，不含真密钥（进公库）
# 复制为 server/.env 后按需修改；.env 由 .gitignore 挡死。

# SQLite 库路径；相对路径以 server/ 为基准
DB_PATH=data/family_todo.db

# 埋点日桶保留天数；0 表示不保留明细（仅长期汇总）
STATS_RETENTION_DAYS=90

# 监听地址与端口（uvicorn 也可用命令行参数覆盖）
HOST=0.0.0.0
PORT=8000

# 家庭令牌不要写在这里，用 CLI 生成后另存：
#   python -m app.cli create-family --name "我的家"
# FAMILY_TOKEN=
