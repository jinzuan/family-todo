<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限：WebView 加载网页 + 小组件读写接口 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyTodo"
        android:usesCleartextTraffic="true">

        <!-- 主界面：WebView 承载 M2 网页；挂启动主题实现冷启动品牌页 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FamilyTodo.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置 / 加入家庭 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- 前台服务占位：M4 推送/常驻通知在此实现，当前不主动启动 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false" />

        <!-- 桌面小组件：3×2 默认预设（resizeMode 支持 API 31+ 自由缩放） -->
        <receiver
            android:name=".widget.TodoWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.familytodo.app.action.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_info" />
        </receiver>

        <!-- 宽版 4×2 预设 -->
        <receiver
            android:name=".widget.TodoWidgetWideProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.familytodo.app.action.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_wide_info" />
        </receiver>

        <!-- 紧凑 2×2 预设 -->
        <receiver
            android:name=".widget.TodoWidgetSmallProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.familytodo.app.action.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_small_info" />
        </receiver>

        <!-- 小组件「点即勾」广播接收器 -->
        <receiver
            android:name=".widget.CompleteActionReceiver"
            android:exported="false" />

        <!-- 小组件列表数据源（RemoteViewsService） -->
        <service
            android:name=".widget.TodoWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
