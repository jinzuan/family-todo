<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页排版样式：浅色卡片 + 大圆角 + 细描边，顶部自绘绿色头部栏。
  「关于」区改成品牌徽标 + 版本胶囊 + 标签/值两列，比一排纯文字更精致。
-->
<resources>

    <!-- ===== 顶部头部栏（替代被 NoActionBar 隐藏的 ActionBar） ===== -->
    <style name="SettingsAppBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_app_bar</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="SettingsAppBarTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsBackButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:contentDescription">@string/action_back</item>
        <item name="android:padding">10dp</item>
        <item name="android:src">@drawable/ic_arrow_back</item>
        <item name="android:tint">@color/white</item>
    </style>

    <!-- ===== 卡片 ===== -->
    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_settings_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:elevation">1dp</item>
    </style>

    <!-- 卡片主标题：左侧一条主色短竖条 + 文字（竖条在布局里用 View 实现） -->
    <style name="SettingsSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 标题左侧的小色条 -->
    <style name="SettingsSectionBar">
        <item name="android:layout_width">4dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_section_bar</item>
    </style>

    <!-- 卡片内小标题（如「制作者」） -->
    <style name="SettingsSubTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 输入框上方的字段说明（整行） -->
    <style name="SettingsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/settings_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 输入框：大圆角、柔和描边，聚焦时描边变主色 -->
    <style name="SettingsInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <!-- 关掉 AppCompat 默认背景着色，避免把自绘描边染色 -->
        <item name="android:backgroundTint">@null</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textColorHint">@color/settings_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- 整行标签 + 值 -->
    <style name="SettingsFieldLabel">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/settings_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsFieldValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 整行的值文本 -->
    <style name="SettingsValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 次要说明 / 提示 -->
    <style name="SettingsHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/settings_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- 卡片内分组分隔线 -->
    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@color/settings_divider</item>
    </style>

    <!-- ===== 按钮 ===== -->
    <style name="SettingsButtonPrimary">
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SettingsButtonOutline">
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 关于区：版本号胶囊 -->
    <style name="SettingsChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/todo_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 关于区：应用名 -->
    <style name="SettingsBrandName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
