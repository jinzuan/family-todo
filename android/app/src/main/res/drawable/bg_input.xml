<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框：圆角填充 + 描边，聚焦时描边变主色 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_input_bg_focus" />
            <corners android:radius="13dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/todo_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_input_bg" />
            <corners android:radius="13dp" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_input_stroke" />
        </shape>
    </item>
</selector>
