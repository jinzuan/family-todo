<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面左下角设置按钮：白色圆形 + 轻描边 + 水波纹按压反馈 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/settings_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/settings_surface" />
            <stroke
                android:width="1dp"
                android:color="#14000000" />
        </shape>
    </item>
</ripple>
